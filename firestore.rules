rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users can only access their own data
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      // Node data subcollections
      match /nodes/{nodeId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      
      // Alerts subcollection
      match /alerts/{alertId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      
      // Routing logs subcollection
      match /routing_logs/{logId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      
      // Legacy subcollections
      match /feeding_logs/{logId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      
      match /schedules/{scheduleId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      
      match /feeder/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      
      match /fcm_tokens/{tokenId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
    
    // Shelter monitoring node calibration data
    match /shelter/nodes/{nodeId}/calibration {
      allow read: if request.auth != null;
      allow write: if request.auth != null;
    }
  }
}


